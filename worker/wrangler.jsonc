{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lucky-draw-pro-rooms",
  "account_id": "6fb14440d4951cac8999ea98d47485df",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "DrawRoom" }]
  },
  "exports": {
    "DrawRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://lucky-draw-pro.vercel.app,http://localhost:3000"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
